  { name="Channel Name",   ct="Text",      pin="Both",   col=1, lbl="Name (8 char set)" },
  { name="Dante Name",     ct="Indicator", it="Text",    pin="Output", col=1, lbl="Dante Ch Name" },
  { name="Available",      ct="Indicator", it="Led",     pin="Output", col=1, lbl="Available", color="#FF00C000" },
  { name="Mute",           ct="Button",    bt="Toggle",  pin="Both",   col=1, lbl="Mute", color="#FFE00000" },
  { name="Gain",           ct="Knob",      unit="dB", min=-18, max=42, pin="Both", col=1, lbl="Gain", style="Knob", w=36, h=36 },
  { name="Flash",          ct="Button",    bt="Trigger", pin="Input",  col=1, lbl="Identify" },
  { name="Alarm",          ct="Indicator", it="Led",     pin="Output", col=1, lbl="Alarm (any)", color="#FFFF2020" },

