  { name="Interference 2", ct="Indicator", it="Led",     pin="Output", col=2, lbl="Interference 2", color="#FFFF2020", mode="AD" },
  { name="Encryption Mode",ct="Indicator", it="Text",    pin="Output", col=2, lbl="Encryption" },
