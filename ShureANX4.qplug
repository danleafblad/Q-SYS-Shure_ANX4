  { name="Frequency 2",    ct="Text",      pin="Both",   col=2, lbl="Frequency 2 (FD-C)", mode="AD" },
  { name="Group Channel 2",ct="Text",      pin="Both",   col=2, lbl="Group,Chan 2 (FD-C)", mode="AD" },
  { name="RF Band",        ct="Indicator", it="Text",    pin="Output", col=2, lbl="RF Band" },
  { name="Antenna Config", ct="Indicator", it="Text",    pin="Output", col=2, lbl="Antenna Config" },
